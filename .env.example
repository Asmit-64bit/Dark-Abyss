# ==============================================================================
# ABYSS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your API credentials
# ==============================================================================

# --- GOOGLE GEMINI MULTI-KEY ROTATION POOL (Add up to 6 keys) ---
# When a key runs out of credits or encounters 429 rate limits,
# the backend automatically switches to the next available key in the pool.

GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=

# Or provide a single comma-separated list of keys:
# GEMINI_API_KEYS=key1,key2,key3,key4,key5,key6

# Default fallback model
GEMINI_MODEL=gemini-3.5-flash

# --- SUPABASE DATABASE & AUTH CONFIGURATION ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
