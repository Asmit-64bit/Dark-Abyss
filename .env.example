# ==============================================================================
# ABYSS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your API credentials
# ==============================================================================

# --- GROQ MULTI-KEY ROTATION POOL (Add up to 6 keys) ---
# Ultra-fast inference with Llama 3.3 70B & Llama 3.1 8B.
# Get free API keys from: https://console.groq.com/keys
# When a key encounters 429 rate limits (TPM/RPM) or credit limits,
# the backend automatically switches to the next available key in the pool.

GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=

# Or provide a single primary key:
GROQ_API_KEY=

# Default Groq model (Primary: openai/gpt-oss-120b, Failover: groq/compound, qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# --- SUPABASE DATABASE & AUTH CONFIGURATION ---
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
